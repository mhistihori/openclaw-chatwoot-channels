# Copy to .env. scripts/dev-up.sh fills in the generated secrets for you.
# .env is gitignored. Never commit real keys.

# --- generated by scripts/dev-up.sh ---
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
OPENCLAW_GATEWAY_TOKEN=

# --- ports (all bound to 127.0.0.1) ---
CHATWOOT_PORT=3100
OPENCLAW_PORT=18789

# --- OpenClaw version used by the dev stack ---
OPENCLAW_VERSION=2026.11.3

# --- model provider: set at least one so the agent can answer ---
# Without a key the plugin still works end to end, but every turn fails and
# the conversation is handed to a human (useful for testing the handoff path).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
